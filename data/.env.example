# Скопируйте в data/.env и заполните. Файл .env не входит в экспорт и не отдаётся браузеру.
# Права: chmod 600 data/.env (при более широких правах сервер пишет предупреждение в лог).

# Пароль для входа. Пусто + HOST=127.0.0.1 → вход без пароля (только с этого компьютера).
# Обязателен, если HOST не 127.0.0.1 (иначе сервер не запустится).
# Смена пароля завершает все выданные сессии.
PASSWORD=

# Порт сервера
PORT=8787

# 127.0.0.1 — только этот компьютер; 0.0.0.0 — доступ из сети (телефон через Tailscale/WireGuard)
HOST=127.0.0.1

# Дополнительные разрешённые имена в заголовке Host/Origin (через запятую, порт необязателен).
# Всегда разрешены: localhost, 127.0.0.1, [::1] и сам HOST (при HOST=0.0.0.0 — адреса интерфейсов).
# Нужно, если открываете панель по имени, например через Tailscale MagicDNS. Иначе — ответ 421.
# Пример: ALLOWED_HOSTS=mac.tail1234.ts.net,mac.local:8787
ALLOWED_HOSTS=

# «Проверить сайт» не обращается к внутренним адресам (localhost, 10.x, 172.16–31.x, 192.168.x,
# 169.254.x, fc00::/7, fe80::/10, ::1). Исключения — имена хостов через запятую.
# Пример для локального агента «Мир»: CHECK_ALLOW_PRIVATE_HOSTS=localhost
CHECK_ALLOW_PRIVATE_HOSTS=
